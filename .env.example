# Copy this file to .env and replace the placeholder values.
# .env is loaded automatically from the working directory or its parents.
# Process environment variables take precedence over values in .env.
#
# Docker / docker-compose usage:
#   When using docker-compose, set these via the `environment:` section
#   in docker-compose.yml, or export them on the host before running `docker run`.
#   The docker-compose.yml below defines BANK_DB_HOST=mysql (service name)
#   BANK_DB_USER=bank_user and BANK_DB_PASS=bank_pass for the MySQL service.
#
# Local / bare-metal usage:
#   Place this file as .env in the project root, or export the variables
#   in your shell. The application searches upward from the CWD for .env.
#
#   On Docker hosts, you can also pass these as `-e BANK_DB_HOST=...` to `docker run`
#   or let docker-compose inject them via the `environment:` section.
BANK_DB_HOST=127.0.0.1
BANK_DB_PORT=3306
# Docker: use the MySQL service name; bare-metal: 127.0.0.1 or localhost
BANK_DB_USER=bank_user
# Docker: set to the password defined in docker-compose MYSQL_PASSWORD;
#           bare-metal: replace with your actual MySQL user password
BANK_DB_PASS=bank_pass
# Database name; must match the database created in Docker or SQL initialization
BANK_DB_NAME=bank_test
# Dashboard authentication (optional).
#   Set BANK_DASHBOARD_AUTH_TOKEN to a secret value to require an
#   X-Auth-Token header on all dashboard API endpoints.
#   If omitted, the dashboard accepts all connections (backward compatible).
#   Example: BANK_DASHBOARD_AUTH_TOKEN=supersecret123
BANK_DASHBOARD_AUTH_TOKEN=
